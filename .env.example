# ===== PEGINTI IA — configuration (copiée en .env par setup_termux.sh ; ne JAMAIS commiter .env) =====
PEGINTI_ENV=production
PORT=3000
HOST=127.0.0.1
PEGINTI_BASE_URL=https://www.pegintichat.online

# Secret serveur (poivre des mots de passe + chiffrement des secrets 2FA). 32+ caractères.
# ATTENTION : le changer invalide tous les mots de passe et la 2FA existants.
PEGINTI_PEPPER=CHANGEZ_MOI_AVEC_setup_termux

# Derrière le tunnel Cloudflare : lit l'IP réelle dans CF-Connecting-IP (uniquement depuis 127.0.0.1)
TRUST_CLOUDFLARE=1

# Moteur de raisonnement (Gemini) et veille (NewsData, optionnel : les flux RSS fonctionnent sans clé)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEWSDATA_API_KEY=

# E-mails (vérification d'adresse, mot de passe oublié). Sans SMTP : liens écrits dans les journaux.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pegintichat.online
# 1 = connexion refusée tant que l'e-mail n'est pas confirmé (défaut : actif si SMTP_HOST renseigné)
VERIFICATION_EMAIL_REQUISE=

# Tunnel Cloudflare « peginti-server » géré depuis le tableau de bord (Zero Trust → Networks → Tunnels).
# Collez ici le jeton affiché dans « Installer et exécuter un connecteur » (la valeur après --token).
CLOUDFLARE_TUNNEL_TOKEN=

# Chat interactif : aucun quota de messages. Garde anti-rafale seulement (requêtes max par 10 s et par client,
# inatteignable à la main). 0 = aucune garde du tout (déconseillé : un robot pourrait épuiser votre clé Gemini).
CHAT_ANTIFLOOD=30

# Équipe TOMTECH.INC : toute adresse de ce domaine (et tout compte technique/admin/superadmin) doit activer la 2FA par application.
PEGINTI_DOMAINE_EQUIPE=tomtech.inc

# Logiciels Peginti publiés par le super administrateur (dossier hors du code) et taille maximale d'un fichier.
PEGINTI_LOGICIELS=data/logiciels
UPLOAD_MAX_MO=95
